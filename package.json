{
  "name": "nexus-agent",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "nexus": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "setup": "tsx src/index.ts setup",
    "node:reference": "tsx examples/nexus-node/reference-node.ts",
    "node:lite": "tsx examples/nexus-node/reference-node-lite.ts",
    "node:lite:build": "tsup --config tsup.node-lite.config.ts",
    "node:reference:smoke": "tsx examples/nexus-node/smoke.ts",
    "node:gateway:smoke": "tsx examples/nexus-node/gateway-delivery-smoke.ts",
    "node:ha:smoke": "tsx examples/nexus-node/ha-smoke.ts",
    "node:update:host": "bash examples/nexus-node/update-node-background.sh",
    "node:deploy": "bash infra/scripts/node/deploy-nexus-node-linux.sh",
    "node:deploy:linux": "bash infra/scripts/node/deploy-nexus-node-linux.sh",
    "node:deploy:macos": "bash infra/scripts/node/deploy-nexus-node-linux.sh",
    "node:deploy:lite:ssh": "bash infra/scripts/node/deploy-nexus-node-lite-ssh.sh",
    "node:upgrade:lite:ssh": "bash infra/scripts/node/upgrade-nexus-node-lite-ssh.sh",
    "ha:tls:cert": "bash infra/scripts/setup/ha-generate-tls-cert.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "security:audit": "npm audit --audit-level=high",
    "security:audit:fix": "npm audit fix",
    "security:deps": "npm audit --audit-level=moderate",
    "security:semgrep": "semgrep --config semgrep.yml --error --metrics=off src/",
    "security:semgrep:docker": "docker run --rm -v \"$(pwd):/src\" returntocorp/semgrep semgrep --config /src/semgrep.yml --error --metrics=off /src/src",
    "security:gitleaks": "gitleaks detect --source . --no-git --config .gitleaks.toml",
    "security:gitleaks:docker": "docker run --rm -v \"$(pwd):/repo\" zricethezav/gitleaks:latest detect --source /repo --no-git --config /repo/.gitleaks.toml",
    "security:all": "npm run typecheck && npm run lint && npm run security:audit",
    "security:all:deep": "npm run security:all && npm run security:semgrep && npm run security:gitleaks"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/stream": "^1.0.0",
    "@hono/node-server": "^1.19.10",
    "@steipete/bird": "^0.8.0",
    "better-sqlite3": "^11.7.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0",
    "hono": "^4.12.4",
    "json5": "^2.2.3",
    "playwright-core": "^1.50.0",
    "rss-parser": "^3.13.0",
    "ws": "^8.19.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-security": "^1.7.1",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
