[Unit]
Description=Nexus Host Change Worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=nexus
WorkingDirectory=/data/code
Environment=CODE_DIR=/data/code
Environment=STATE_DIR=/data/nexus
Environment=POLL_INTERVAL=5
Environment=COMPOSE_PROJECT=infra
Environment=COMPOSE_FILE=/data/code/infra/docker-compose.ha.yml
Environment=API_URL=http://localhost:18789
Environment=CHANGE_WORKER_DRY_RUN=0
ExecStart=/data/code/infra/scripts/change-worker.sh daemon
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
