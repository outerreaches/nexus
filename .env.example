# LLM (OpenRouter)
OPENROUTER_API_KEY=

# Web search (optional)
BRAVE_API_KEY=
PERPLEXITY_API_KEY=

# Data intake sources (optional)
OPEN_METALS_API_KEY=
ALPHAVANTAGE_API_KEY=
MARKETSTACK_API_KEY=
TWELVEDATA_API_KEY=
COINLAYER_API_KEY=
CRYPTOCOMPARE_API_KEY=
AUTH_TOKEN=
CT0=
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
# Telegram file I/O (optional)
# NEXUS_TELEGRAM_MAX_INBOUND_FILES_PER_MESSAGE=5
# NEXUS_TELEGRAM_MAX_INBOUND_FILE_BYTES=20971520
# NEXUS_TELEGRAM_FILE_BLACKBOARD_TTL_MS=2592000000
# NEXUS_TELEGRAM_SEND_FILE_ALLOW_ANY=0

# Gmail API (optional; recommended vs browser-login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:18790/oauth2callback

# Local credential vault (optional; used for browser logins without sending passwords to the LLM)
NEXUS_CREDENTIALS_KEY=

# Proactive heartbeat scheduler (optional)
NEXUS_PROACTIVE=1
NEXUS_PROACTIVE_INTERVAL_MS=900000
NEXUS_PROACTIVE_MAX_INTERVAL_MS=3600000
NEXUS_PROACTIVE_JITTER_MS=5000
NEXUS_PROACTIVE_NOTIFY_TELEGRAM=1
