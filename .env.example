# ────────────────────────────────────────────────────────────────────────────
# API keys, tokens, and other secrets are now configured in nexus.json
# under the "secrets.env" block using {{secret:provider/path#field}} references.
# They are resolved through the sidecar/broker/provider stack at startup.
#
# Example nexus.json entry:
#   "secrets": {
#     "env": {
#       "BRAVE_API_KEY": "{{secret:sidecar-main/brave-api-key#password}}",
#       "TELEGRAM_BOT_TOKEN": "{{secret:sidecar-main/telegram-bot-token#password}}"
#     }
#   }
#
# See the secrets playbook for provider setup and credential storage.
# The following env vars are now managed via secrets.env:
#   OPENROUTER_API_KEY, BRAVE_API_KEY, PERPLEXITY_API_KEY,
#   TELEGRAM_BOT_TOKEN, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
#   ALPHAVANTAGE_API_KEY, MARKETSTACK_API_KEY, TWELVEDATA_API_KEY,
#   COINLAYER_API_KEY, CRYPTOCOMPARE_API_KEY, OPEN_METALS_API_KEY,
#   AUTH_TOKEN, CT0, TWITTER_AUTH_TOKEN, TWITTER_CT0
# ────────────────────────────────────────────────────────────────────────────

# Optional local OpenAI-compatible provider (LM Studio/Ollama proxy/etc)
# NEXUS_LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
# NEXUS_LOCAL_LLM_API_KEY=
# NEXUS_LOCAL_LLM_MODEL=

# Telegram file I/O (optional, non-secret config)
# NEXUS_TELEGRAM_MAX_INBOUND_FILES_PER_MESSAGE=5
# NEXUS_TELEGRAM_MAX_INBOUND_FILE_BYTES=20971520
# NEXUS_TELEGRAM_FILE_BLACKBOARD_TTL_MS=2592000000
# NEXUS_TELEGRAM_LLM_MAX_INLINE_IMAGES=3
# NEXUS_TELEGRAM_LLM_MAX_INLINE_IMAGE_BYTES=4194304
# NEXUS_TELEGRAM_SEND_FILE_ALLOW_ANY=0

# LangExtract tool (optional)
# NEXUS_LANGEXTRACT_PYTHON=python3
# NEXUS_LANGEXTRACT_MODEL=moonshotai/kimi-k2.5
# NEXUS_LANGEXTRACT_TIMEOUT_MS=180000

# Local credential vault (optional; used for browser logins without sending passwords to the LLM)
NEXUS_CREDENTIALS_KEY=
# Gateway HTTP auth (optional).
# To enable, set NEXUS_HTTP_AUTH_ENABLED=1 and provide one or more secrets below.
# NEXUS_HTTP_AUTH_ENABLED=1
# Shared fallback secret for both API key and dashboard login password.
# NEXUS_HTTP_AUTH_TOKEN=
# API key for machine clients (Authorization: Bearer <key> or x-nexus-api-key).
# NEXUS_HTTP_API_KEY=
# HA/watchdog control-plane API key (set to same value as NEXUS_HTTP_API_KEY when auth is enabled).
# NEXUS_HA_API_KEY=
# Dashboard login credentials.
# NEXUS_DASHBOARD_USERNAME=admin
# NEXUS_DASHBOARD_PASSWORD=
# Session controls (defaults shown).
# NEXUS_HTTP_AUTH_SESSION_TTL_MS=43200000
# NEXUS_HTTP_AUTH_SESSION_CLEANUP_INTERVAL_MS=600000
# NEXUS_HTTP_AUTH_COOKIE_NAME=nexus_dashboard_session
# Force Secure cookies behind HTTPS reverse proxy (set to 1 when terminating TLS upstream).
# NEXUS_HTTP_AUTH_COOKIE_SECURE=0
# Secrets strict mode (recommended; blocks plaintext credential writes when key/provider prerequisites are missing)
# Set to 0 only for local development where plaintext fallback is explicitly acceptable.
# NEXUS_SECRETS_STRICT=1
# Optional credential store override for storage isolation.
# Use one of the following (absolute paths only):
# NEXUS_CREDENTIALS_STORE_DIR=/data/nexus-secrets
# NEXUS_CREDENTIALS_STORE_PATH=/data/nexus-secrets/credentials.json
# Enforce sidecar-only secret resolution and disable local_file provider usage.
# When enabled, non-sidecar processes cannot directly read/write credentials.json.
# Recommended production setting: 1 (sidecar-only).
# NEXUS_SECRETS_SIDECAR_ONLY=1
# Process role for credential access guardrails (auto-set to sidecar by `nexus secret-sidecar`).
# NEXUS_SECRETS_PROCESS_ROLE=gateway
# Optional secret-broker auth material (for sidecar_http / vault/openbao provider profiles).
# Workload identity bearer token for broker calls when authMode=workload_identity.
# NEXUS_SECRET_BROKER_BEARER_TOKEN=
# mTLS client materials for broker calls when authMode=mtls.
# NEXUS_SECRET_BROKER_CLIENT_CERT_FILE=/data/nexus/secrets/broker-client.crt
# NEXUS_SECRET_BROKER_CLIENT_KEY_FILE=/data/nexus/secrets/broker-client.key
# Optional custom CA bundle for broker TLS verification when authMode=mtls.
# NEXUS_SECRET_BROKER_CA_FILE=/data/nexus/secrets/broker-ca.crt
# Built-in secret sidecar settings (for same-host process/API boundary deployment).
# Recommended in strict mode: unix socket + authMode=unix_peer provider profile.
# NEXUS_SECRET_SIDECAR_SOCKET_PATH=/run/nexus/secret-sidecar.sock
# Optional TCP mode (requires bearer token in strict mode):
# NEXUS_SECRET_SIDECAR_BIND=127.0.0.1
# NEXUS_SECRET_SIDECAR_PORT=7788
# NEXUS_SECRET_SIDECAR_BEARER_TOKEN=
# NEXUS_SECRET_SIDECAR_MAX_BODY_BYTES=32768
# Monetization-only credential prefixes and path guards (comma-separated, advanced override).
# NEXUS_MONETIZATION_SECRET_PREFIXES=wallet.,exchange.,risk.,monetization.
# NEXUS_MONETIZATION_LOCAL_PATH_PATTERNS=/secrets/credentials.json,/monetization/risk-policy.json,/monetization/wallet-policy.json,/monetization/wallet-keys.json

# Federation ingress body caps (bytes) for anti-DoS hardening.
# NEXUS_FEDERATION_INGRESS_MAX_BODY_BYTES=262144
# NEXUS_FEDERATION_WEBHOOK_MAX_BODY_BYTES=262144
# Federation session heartbeat TTL (ms) used by dispatcher/API session refresh logic.
# NEXUS_FEDERATION_SESSION_HEARTBEAT_TTL_MS=600000

# Proactive heartbeat scheduler (optional)
NEXUS_PROACTIVE=1
NEXUS_PROACTIVE_INTERVAL_MS=900000
NEXUS_PROACTIVE_MAX_INTERVAL_MS=3600000
NEXUS_PROACTIVE_JITTER_MS=5000
NEXUS_PROACTIVE_NOTIFY_TELEGRAM=1
# Minimum fraction of preset budget when spawn_agent passes explicit budget overrides
# NEXUS_SPAWN_BUDGET_MIN_RATIO=0.75
