# HA + sidecar deployments use split env files in isolated host folders:
#   - `/data/nexus-config/gateway/nexus.env`   (gateway containers only)
#   - `/data/nexus-config/sidecar/nexus.env`   (secret-sidecar container only)
#   - `/data/nexus-config/watchdog/nexus.env`  (watchdog container only)
#
# Bootstrap commands:
#   sudo mkdir -p /data/nexus-config/{gateway,sidecar,watchdog}
#   sudo cp /data/code/.env.gateway.example /data/nexus-config/gateway/nexus.env
#   sudo cp /data/code/.env.sidecar.example /data/nexus-config/sidecar/nexus.env
#   sudo cp /data/code/.env.watchdog.example /data/nexus-config/watchdog/nexus.env
#   sudo chmod 600 /data/nexus-config/gateway/nexus.env /data/nexus-config/sidecar/nexus.env /data/nexus-config/watchdog/nexus.env
#
# This file is kept only as a compatibility pointer.
