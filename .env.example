# HA + sidecar deployments use split env files:
#   - `.env.gateway`  (gateway containers only)
#   - `.env.sidecar`  (secret-sidecar container only)
#   - `.env.watchdog` (watchdog container only)
#
# Bootstrap commands:
#   cp .env.gateway.example .env.gateway
#   cp .env.sidecar.example .env.sidecar
#   cp .env.watchdog.example .env.watchdog
#
# This file is kept only as a compatibility pointer.
