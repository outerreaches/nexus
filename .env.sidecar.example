# Sidecar env (loaded by secret-sidecar only)

# Local credential vault encryption key (required).
NEXUS_CREDENTIALS_KEY=

# Secret manager script operator credentials (required by ha-secretctl.sh / ha-secrets-onboard.sh).
NEXUS_SECRETCTL_USERNAME=admin
NEXUS_SECRETCTL_PASSWORD=

# Optional credential store override for storage isolation.
# Use one of the following (absolute paths only):
# NEXUS_CREDENTIALS_STORE_DIR=/data/nexus-secrets
# NEXUS_CREDENTIALS_STORE_PATH=/data/nexus-secrets/credentials.json

# Process role for credential access guardrails (auto-set to sidecar by `nexus secret-sidecar`).
# NEXUS_SECRETS_PROCESS_ROLE=sidecar

# Optional secret-broker auth material (for sidecar_http / vault/openbao provider profiles).
# NEXUS_SECRET_BROKER_BEARER_TOKEN=
# NEXUS_SECRET_BROKER_CLIENT_CERT_FILE=/data/nexus/secrets/broker-client.crt
# NEXUS_SECRET_BROKER_CLIENT_KEY_FILE=/data/nexus/secrets/broker-client.key
# NEXUS_SECRET_BROKER_CA_FILE=/data/nexus/secrets/broker-ca.crt

# Built-in secret sidecar transport settings.
# NEXUS_SECRET_SIDECAR_SOCKET_PATH=/run/nexus/secret-sidecar.sock
# NEXUS_SECRET_SIDECAR_BIND=127.0.0.1
# NEXUS_SECRET_SIDECAR_PORT=7788
# NEXUS_SECRET_SIDECAR_BEARER_TOKEN=
# NEXUS_SECRET_SIDECAR_MAX_BODY_BYTES=32768

# Monetization-only credential prefixes and path guards (advanced override).
# NEXUS_MONETIZATION_SECRET_PREFIXES=wallet.,exchange.,risk.,monetization.
# NEXUS_MONETIZATION_LOCAL_PATH_PATTERNS=/secrets/credentials.json,/monetization/risk-policy.json,/monetization/wallet-policy.json,/monetization/wallet-keys.json
